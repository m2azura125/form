# =====================================================================
# Contoh konfigurasi .env untuk deploy ke Hostinger (Shared/Cloud Hosting)
#
# Cara pakai:
# 1. Upload seluruh project ke Hostinger (lewat File Manager/FTP/Git).
# 2. Salin file ini jadi `.env` di root project, lalu isi semua nilai
#    bertanda GANTI_INI sesuai data di hPanel Hostinger kamu.
# 3. Jalankan `php artisan key:generate` sekali di awal (lewat SSH/Terminal
#    Hostinger, atau generate lokal lalu tempel nilainya ke APP_KEY).
# 4. Arahkan document root domain ke folder `public/` project ini
#    (hPanel > Websites > Manage > Advanced > Document Root), supaya
#    tidak perlu trik .htaccess redirect ke /public.
# =====================================================================

APP_NAME="Form Pengajuan Project"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI_INI-domainmu.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Di production cukup catat error, jangan debug (hindari log membengkak)
LOG_LEVEL=error

# Kredensial database dari hPanel > Databases > Management.
# Hostinger menambahkan prefix akun (u123456789_) otomatis di nama
# database dan username — jangan hilangkan prefix itu.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_GANTI_INI
DB_USERNAME=u123456789_GANTI_INI
DB_PASSWORD=GANTI_INI

# Wajib true karena domain Hostinger sudah pakai SSL gratis (HTTPS).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Shared hosting Hostinger umumnya tidak menyediakan queue worker/daemon
# yang jalan terus-menerus, jadi pakai driver sync/database (bukan redis).
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# Isi kalau butuh kirim email (reset password dll). Hostinger biasanya
# menyediakan SMTP lewat email hosting yang satu paket dengan domainmu
# (cek hPanel > Emails > Connect Apps and Devices untuk host/port/kredensial),
# atau pakai layanan pihak ketiga (Mailgun/SendGrid/dst).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=GANTI_INI@domainmu.com
MAIL_PASSWORD=GANTI_INI
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="GANTI_INI@domainmu.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
